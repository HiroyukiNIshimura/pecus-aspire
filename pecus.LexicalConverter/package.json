{
  "name": "pecus.lexicalconverter",
  "version": "1.0.0",
  "description": "Lexical JSON to HTML/Markdown/PlainText converter gRPC service",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc --incremental false",
    "start": "node --experimental-loader ./dist/ignore-css-loader.js dist/main.js",
    "start:dev": "npm run build && node --experimental-loader ./dist/ignore-css-loader.js dist/main.js",
    "start:debug": "npm run build && node --inspect-brk --experimental-loader ./dist/ignore-css-loader.js dist/main.js",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --fix src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --fix src/",
    "update:check": "ncu",
    "update": "ncu -u"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@coati/editor": "*",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@lexical/code": "0.52.0",
    "@lexical/headless": "0.52.0",
    "@lexical/html": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/mark": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/overflow": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/table": "0.52.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.2",
    "lexical": "0.52.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "npm-check-updates": "^23.1.0",
    "typescript": "^7.0.2"
  }
}
